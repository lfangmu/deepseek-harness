{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DSH Desktop - DeepSeek Harness",
  "main": "main.js",
  "author": "DeepSeek AI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DSH",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "package.json",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  }
}